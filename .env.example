# =========================
# 1. Vision model (main)  - REQUIRED
# =========================
GEMINI_API_KEY=your_google_ai_studio_key
VISION_MODEL=<gemini-flash-model-id>
VISION_TIMEOUT_MS=20000

# =========================
# 2. Fallback vision (Llama via OpenRouter)  - OPTIONAL
# =========================
OPENROUTER_API_KEY=
VISION_FALLBACK_MODEL=<llama-vision-model-slug>

# =========================
# 3. Merge model (cleans up names after geocoding)  - OPTIONAL
# =========================
ENABLE_MERGE=false
MERGE_PROVIDER=openrouter          # openrouter | groq
MERGE_MODEL=<llama-text-model-slug>
MERGE_TIMEOUT_MS=15000
GROQ_API_KEY=                      # only if MERGE_PROVIDER=groq

# =========================
# 4. Geocoding (Nominatim, no key needed)
# =========================
GEOCODER_USER_AGENT=image-location-finder
GEOCODER_RATE_LIMIT_MS=1000

# =========================
# 5. Pipeline behavior
# =========================
USE_EXIF_GPS=true
CONFIDENCE_THRESHOLD=0.4           # below this, return "unable to determine"
MAX_UPLOAD_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# =========================
# 6. Server
# =========================
APP_PORT=3000