# =========================
# 1. Vision model (main)  - REQUIRED
# =========================
GEMINI_API_KEY=your_google_ai_studio_key
VISION_MODEL=<gemini-flash-model-id>
VISION_TIMEOUT_MS=20000

# =========================
# 2. Fallback vision (Llama via OpenRouter)  - OPTIONAL
# =========================
OPENROUTER_API_KEY=
VISION_FALLBACK_MODEL=<llama-vision-model-slug>

VISION_PRIMARY_MODEL=<primary-vision-model-id>
VISION_DETAIL_MODEL=<detail-vision-model-id>

MAX_DETAIL_CROPS=5
MAX_PARALLEL_VISION=2

# =========================
# 2A. Multi-model vision
# =========================

# Primary model for complete-image analysis
VISION_PRIMARY_MODEL=<primary-vision-model-id>

# Model used for detailed/cropped image analysis
VISION_DETAIL_MODEL=<detail-vision-model-id>

# Backup model if primary/detail model fails
VISION_FALLBACK_MODEL=<fallback-vision-model-slug>

# Maximum number of detail regions to analyze
MAX_DETAIL_CROPS=5

# Maximum parallel vision requests
MAX_PARALLEL_VISION=2

# =========================
# OCR
# =========================

OCR_PROVIDER=
OCR_TIMEOUT_MS=10000

# =========================
# Evidence scoring
# =========================

WEIGHT_GPS=100
WEIGHT_OCR=40
WEIGHT_LANDMARK=40
WEIGHT_VISION_AGREEMENT=25
WEIGHT_ARCHITECTURE=15
WEIGHT_ROAD=15
WEIGHT_VEHICLE=10
WEIGHT_VEGETATION=5

CONTRADICTION_PENALTY=30

# =========================
# Image analysis
# =========================

ENABLE_IMAGE_CROPS=true
ENABLE_OCR=true
ENABLE_DETAIL_ANALYSIS=true
ENABLE_CONTRADICTION_CHECK=true
ENABLE_EVIDENCE_SCORING=true

# =========================
# 3. Merge model (cleans up names after geocoding)  - OPTIONAL
# =========================
ENABLE_MERGE=false
MERGE_PROVIDER=openrouter          # openrouter | groq
MERGE_MODEL=<llama-text-model-slug>
MERGE_TIMEOUT_MS=15000
GROQ_API_KEY=                      # only if MERGE_PROVIDER=groq

# =========================
# 4. Geocoding (Nominatim, no key needed)
# =========================
GEOCODER_USER_AGENT=image-location-finder
GEOCODER_RATE_LIMIT_MS=1000

# =========================
# 5. Pipeline behavior
# =========================
USE_EXIF_GPS=true
CONFIDENCE_THRESHOLD=0.4           # below this, return "unable to determine"
MAX_UPLOAD_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# =========================
# 6. Server
# =========================
APP_PORT=3000

# =========================
# 7. Rate-limit
# =========================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10

# =========================
# 8. Evidence scoring weights (used by candidate_scorer.js)
# =========================
WEIGHT_GPS=1.0
WEIGHT_OCR=1.0
WEIGHT_LANDMARK=1.0
WEIGHT_VISION_AGREEMENT=1.0

# =========================
# 9. Debug
# =========================
DEBUG_PIPELINE=false